# ── InsForge Backend-as-a-Service (required) ──────────────
# URL: the OSS host shown by `insforge current`
INSFORGE_URL=https://<appkey>.us-east.insforge.app
# Admin API key: `insforge secrets get API_KEY` (server-side only!)
INSFORGE_API_KEY=ik_xxxxxxxxxxxxxxxxxxxxxxxx

# Embeddings go through the InsForge AI gateway (OpenRouter)
EMBEDDING_MODEL=openai/text-embedding-3-small

# ── LLMs & external services ──────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Optional video delivery CDN
MUX_TOKEN_ID=
MUX_SECRET_KEY=

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
