# ── InsForge Backend-as-a-Service (public / browser-safe) ──
# Project URL shown by `insforge current`
NEXT_PUBLIC_INSFORGE_URL=https://<appkey>.us-east.insforge.app
# Anonymous key: `insforge secrets get ANON_KEY` (public by design)
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── FastAPI backend (talks to InsForge Postgres/Auth/Storage) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
